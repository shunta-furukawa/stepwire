{
  "name": "stepwire",
  "version": "0.1.0",
  "private": true,
  "description": "STEPWIRE — DDR Sessions, Charts & Culture. MONO DDR's session blog as a Git repository: collection, drafting, publishing and video generation from one structured content source.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:validate": "tsx scripts/validate-content.ts",
    "article:new": "tsx scripts/create-article.ts",
    "article:from-issue": "tsx scripts/create-article.ts --from-issue",
    "article:from-post": "tsx scripts/create-article.ts --from-post",
    "news:collect": "tsx scripts/collect-news.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm content:validate && pnpm build",
    "narration:transcribe": "tsx scripts/transcribe.ts"
  },
  "dependencies": {
    "@types/three": "0.184.0",
    "fast-xml-parser": "5.11.1",
    "mp4-muxer": "5.2.2",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.184.0",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.518",
    "@remotion/install-whisper-cpp": "4.0.518",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "10.9.1",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
